{
  "name": "cloudix-desktop",
  "productName": "Cloudix",
  "version": "1.0.1",
  "description": "Desktop app for Cloudix",
  "main": "src/main.js",
  "author": "Cloudix",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "build:web": "node scripts/build-web.js",
    "start": "npm run build:app && electron .",
    "dev": "electron .",
    "test": "node test/local-server.test.js && node test/backend-runner.test.js && node test/db-runner.test.js",
    "dist": "npm run build:app && electron-builder",
    "dist:win": "npm run build:app && electron-builder --win",
    "pack:win": "npm run build:app && electron-builder --win --dir",
    "dist:mac": "npm run build:app && electron-builder --mac",
    "dist:linux": "npm run build:app && electron-builder --linux",
    "build:app": "node scripts/build-web.js && node scripts/build-backend.js && node scripts/build-mariadb.js"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.cloudix.desktop",
    "productName": "Cloudix",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "app-dist/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "extraResources": [
      {
        "from": "backend-dist",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "vendor/mariadb",
        "to": "mariadb",
        "filter": [
          "**/*"
        ]
      }
    ],
    "afterPack": "scripts/after-pack.js"
  }
}
